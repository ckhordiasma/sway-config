# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty

# exec albert
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
set $menu dmenu_path | wmenu | xargs swaymsg exec --
# Start your launcher
bindsym $mod+d exec $menu
bindsym $mod+Shift+Return exec firefox


bindsym $mod+tab workspace back_and_forth
# bindsym $mod+tab workspace next

# add night light
exec gammastep -l 21.30694:157.85833

# set color profile
exec dispwin /usr/share/color/icc/colord/NE160QDM-NZ6.icm

exec swaync -c ~/.config/sway/swaync-config.json

# for file choosers, screenshots, etc
exec /usr/lib/xdg-desktop-portal
# specifically for screenshots and screen recording
exec /lib/xdg-desktop-portal-wlr -r -c ~/.config/sway/xdpw-config

# for priv escalation prompt
exec /usr/lib/polkit-kde-authentication-agent-1

exec bash ~/.config/sway/sway-subscribe.sh
### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg /home/chkodama/media/glass-pyramids.jpeg fill 
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

set $framework_monitor 'BOE 0x0BC9 Unknown'

workspace 1 output $framework_monitor
workspace 2 output 'Beihai Century Joint Innovation Technology Co.,Ltd 34CHR Unknown'
workspace 3 output 'Dell Inc. DELL P2419H 30NGR63'
workspace 4 output 'Hewlett Packard HP V241 3CQ41708N3'

output * adaptive_sync off

bindswitch --reload --locked lid:on output $framework_monitor disable
bindswitch --reload --locked lid:off output $framework_monitor enable

bindsym --locked $mod+Shift+M output $framework_monitor toggle

# Framework Monitor
output $framework_monitor \
	resolution 2560x1600@165Hz scale 1.5 pos 0 0

# widescreen - upper lefthand corner of FW monitor
output 'Beihai Century Joint Innovation Technology Co.,Ltd 34CHR Unknown' \
	resolution 3440x1440@59.999Hz scale 1.5 \
	pos -2293 -900

# lower left monitor
output 'Dell Inc. DELL P2419H 30NGR63' \
	resolution --custom 1920x1080@59.999Hz scale 1 \
	pos -4213 -270 \
	


# upper left monitor
output 'Hewlett Packard HP V241 3CQ41708N3' \
	resolution 1920x1080@60Hz scale 1 \
	pos -4213 -1350


### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

# swaylock settings managed separately
exec swayidle -w \
          timeout 300 'swaylock -f --config ~/.config/sway/swaylock-config' \
          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
	  timeout 900 'systemctl suspend-then-hibernate' \
	  idlehint 1500 \
          before-sleep 'swaylock -f --config ~/.config/sway/swaylock-config' \


# this conflicts with other stuff
